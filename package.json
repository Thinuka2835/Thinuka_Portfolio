{
  "name": "thinuka-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "vercel-build": "node scripts/migrate.mjs --if-configured && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "check": "npm run lint && npm test && npm run build",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/functions": "^3.11.3",
    "hono": "^4.13.19",
    "lenis": "^1.3.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.6.0",
    "react-router": "^8.5.1",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=22"
  }
}

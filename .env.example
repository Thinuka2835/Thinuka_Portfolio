# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. NEVER commit real values.
#
# Two kinds of variables:
#   VITE_*   → PUBLIC. Bundled into the browser JavaScript; anyone can read them.
#   others   → SECRET/server-only. Used by /api (Vercel Functions), scripts and
#              the build; never sent to the browser.
# On Vercel set these per environment (Development / Preview / Production).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (server-only) ───────────────────────────────────────────────────
# Neon connection string (Dashboard → Connect → pooled connection).
# For local development without Neon you can use embedded Postgres instead:
#   DATABASE_URL=pglite:./.data/pglite
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional safety net for Preview/Development: your PRODUCTION Neon host.
# Migrations refuse to run against it from a non-production environment.
# PRODUCTION_DATABASE_HOST=ep-xxxxxx-pooler.REGION.aws.neon.tech

# ── Admin (server-only) ──────────────────────────────────────────────────────
# Path the admin UI is served at. One segment, letters/numbers/-/_ (3–64 chars).
# Pick something not obvious. This is only obscurity: authentication is what
# protects the admin. Leave empty to disable the admin UI entirely.
ADMIN_PATH=/studio-change-me

# Session lifetime and inactivity timeout
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Extra origins allowed to make admin requests (comma-separated). The site's own
# origin is always allowed; normally leave empty.
APP_ORIGIN=

# ── Cloudinary (server-only; the API secret must never be VITE_) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio
# MEDIA_MAX_BYTES=10485760

# ── Markdown content store (server-only) ─────────────────────────────────────
# Production: admin edits are committed to GitHub (fine-grained token with
# "Contents: Read and write" on this repository only).
#   CONTENT_STORE=github
#   GITHUB_CONTENT_TOKEN=github_pat_...
#   GITHUB_CONTENT_REPO=Thinuka2835/Thinuka_Portfolio
# Local development: CONTENT_STORE=fs writes to ./content (commit with git yourself).
CONTENT_STORE=fs
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=
# Branch the admin commits to, and the branch Vercel deploys to production.
# Non-production environments refuse to write to the production branch.
CONTENT_BRANCH=main
CONTENT_PRODUCTION_BRANCH=main
# Drafts are disabled because the repository is public (drafts would be
# readable on GitHub). Only set to true if content moves to a private repo.
CONTENT_ALLOW_DRAFTS=false

# ── Deploys (server-only, optional) ──────────────────────────────────────────
# Vercel → Project → Settings → Git → Deploy Hooks. Enables “Rebuild site” in
# the admin (refreshes link-preview tags after profile changes).
VERCEL_DEPLOY_HOOK_URL=

# Absolute site URL for canonical links, Open Graph tags and the sitemap.
# On Vercel this falls back to the production domain automatically.
SITE_URL=

# ── EmailJS (PUBLIC — designed to be visible in the browser) ─────────────────
# Your EmailJS *Private Key* is a secret and is NOT used by this site — never
# put it in a VITE_ variable.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google reCAPTCHA v2 ("I'm not a robot") SITE key — public. Its SECRET key goes
# only into the EmailJS template settings, never here.
VITE_RECAPTCHA_SITE_KEY=
